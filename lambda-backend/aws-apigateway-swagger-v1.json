  "definitions": {
    "BootstrapPingRequest": {
      "type": "object",
      "required": ["awsRegion", "message"],
      "additionalProperties": false,
      "properties": {
        "awsRegion": {
          "type": "string",
          "enum": ["us-east-1", "us-east-2", "us-west-1", "us-west-2", "mx-central-1"]
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        }
      }
    },
    "BankPayload": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "shortName": {
          "type": "string",
          "maxLength": 20
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "iconName": {
          "type": "string",
          "maxLength": 50
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "CategoryPayload": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "iconName": {
          "type": "string",
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income", "both"]
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "SubcategoryPayload": {
      "type": "object",
      "required": ["categoryId", "name"],
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "iconName": {
          "type": "string",
          "maxLength": 50
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "InstrumentPayload": {
      "type": "object",
      "required": ["bankId", "name", "type", "currencyId"],
      "additionalProperties": false,
      "properties": {
        "bankId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": ["credit_card", "debit_card", "account"]
        },
        "lastFour": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "currencyId": {
          "type": "integer",
          "minimum": 1
        },
        "creditLimit": {
          "type": "number",
          "minimum": 0
        },
        "currentBalance": {
          "type": "number",
          "minimum": 0
        },
        "availableCredit": {
          "type": "number",
          "minimum": 0
        },
        "cutOffDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "paymentDueDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "annualRate": {
          "type": "number",
          "minimum": 0
        },
        "currentAmount": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "ReminderPayload": {
      "type": "object",
      "required": ["title", "reminderDate", "type"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "reminderDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "type": {
          "type": "string",
          "enum": ["payment", "cutoff", "subscription", "loan", "custom"]
        },
        "referenceId": {
          "type": "integer",
          "minimum": 1
        },
        "referenceType": {
          "type": "string",
          "maxLength": 30
        },
        "isRead": {
          "type": "boolean"
        },
        "isDismissed": {
          "type": "boolean"
        }
      }
    }
  }
}
